From 1e7396ca5b1685619d47c1e86c240f76d3c08520 Mon Sep 17 00:00:00 2001
From: Sarath <skchingapurathu@gmail.com>
Date: Wed, 21 Oct 2026 20:21:54 -0400
Subject: [PATCH] Slack webhook + ntfy reports, per-stage job names

Fir compute nodes have no mail server but do have internet, so notify() posts to
SLACK_WEBHOOK_URL and/or an ntfy topic, falling back to e-mail. Jobs are named
mop-extract / mop-seedN / mop-final so Slurm's own mails are distinguishable.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01SCnQCibGig91YPGUqFczDv
---
 cluster/GUIDE.md   |  4 ++--
 cluster/config.sh  | 34 ++++++++++++++++++++++++----------
 cluster/run.sbatch |  2 +-
 cluster/submit.sh  |  6 +++---
 4 files changed, 30 insertions(+), 16 deletions(-)

diff --git a/cluster/GUIDE.md b/cluster/GUIDE.md
index cdf8205..b9983f1 100644
--- a/cluster/GUIDE.md
+++ b/cluster/GUIDE.md
@@ -34,8 +34,8 @@ SMOKE=1 bash cluster/submit.sh      # 64 train / 32 eval prompts, 40 steps - che
 bash cluster/submit.sh              # the full run: extract -> seed 0 -> seed 1 -> seed 2 -> final combine (seed 0 results reach Slack before seeds 1-2 start)
 LAYER_SWEEP=0 bash cluster/submit.sh   # same without the layer sweep
 ```
-`submit.sh` prints three job ids. Watch with `squeue -u $USER`; logs are `mop-<jobid>.out` in the repo folder
-(`tail -f mop-<jobid>.out`). If a job dies or times out, fix/extend and run `submit.sh` again: extraction resumes
+`submit.sh` prints three job ids. Watch with `squeue -u $USER`; logs are `mop-<stage>-<jobid>.out (`ls mop-*`)` in the repo folder
+(`tail -f mop-<stage>-<jobid>.out (`ls mop-*`)`). If a job dies or times out, fix/extend and run `submit.sh` again: extraction resumes
 where it stopped (finished samples are skipped).
 
 In the rehearsal's extraction log, look at `samples/s` and `generated tokens/s` per rank and extrapolate the full time.
diff --git a/cluster/config.sh b/cluster/config.sh
index 410cb96..6dcaa53 100755
--- a/cluster/config.sh
+++ b/cluster/config.sh
@@ -3,8 +3,8 @@
 # Override any of them on the command line, e.g.  SEEDS="0" bash cluster/submit.sh
 
 # ---- fill these in ----------------------------------------------------------
-# Slack: the e-mail address of the Mila Slack channel (or DM) that should get the reports.
-# Slack channel -> "Integrations" -> "Send emails to this channel" gives you the address.
+# Slack/phone reports: set SLACK_WEBHOOK_URL and/or NTFY_TOPIC in ~/.bashrc (see notify() below).
+# SLACK_EMAIL (your Slackbot forwarding address) receives Slurm's own BEGIN/END/FAIL mails for every job.
 export SLACK_EMAIL="${SLACK_EMAIL:-}"
 # Your allocation, e.g. def-oberman (see: sacctmgr show assoc user=$USER format=account%30)
 export SBATCH_ACCOUNT="${SBATCH_ACCOUNT:-}"
@@ -44,24 +44,38 @@ export RUN_DIR="$ROOT/outputs/$RUN_NAME"
 export HF_HUB_OFFLINE="${HF_HUB_OFFLINE:-1}" HF_DATASETS_OFFLINE="${HF_DATASETS_OFFLINE:-1}" TRANSFORMERS_OFFLINE="${TRANSFORMERS_OFFLINE:-1}"
 export WANDB_MODE="${WANDB_MODE:-offline}" TOKENIZERS_PARALLELISM=false PYTHONUNBUFFERED=1
 
-# Slack message by e-mail. Never fails the job; always prints the subject to the log.
-# Tries, in order: sendmail, mail, then Python smtplib to the node's local mail server (port 25).
+# Stage reports. Never fails the job; always prints the subject to the log.
+# Channels used if configured (put the secrets in ~/.bashrc as `export ...`, never in the repo):
+#   SLACK_WEBHOOK_URL  Slack incoming webhook posting to your DM   (works from Fir/Nibi compute nodes: they have internet)
+#   NTFY_TOPIC         private topic name for push notifications via ntfy.sh (phone app)
+# If neither is set it falls back to e-mail to SLACK_EMAIL (sendmail, mail, local SMTP) - not available on Fir nodes.
 # usage: notify "subject" ["body"]
 notify() {
-  local subject="[mop ${RUN_NAME}] $1" body="${2:-}" sm msg
+  local subject="[mop ${RUN_NAME}] $1" body="${2:-}" text sent=0 sm msg
   echo "[notify] $subject"
-  [[ -z "$SLACK_EMAIL" ]] && return 0
-  msg="$(printf 'To: %s\nFrom: %s@%s\nSubject: %s\n\n%s\n\nhost=%s job=%s\n' \
-         "$SLACK_EMAIL" "${USER:-mop}" "$(hostname -f 2>/dev/null || hostname)" "$subject" "$body" "$(hostname)" "${SLURM_JOB_ID:-login}")"
+  text="*${subject}*"$'\n'"${body}"$'\n'"host=$(hostname) job=${SLURM_JOB_ID:-login}"
+  if [[ -n "${SLACK_WEBHOOK_URL:-}" ]]; then
+    if printf '%s' "${text:0:30000}" | python3 -c 'import json,sys; print(json.dumps({"text": sys.stdin.read()}))' \
+         | curl -sS --fail -m 20 -X POST -H 'Content-type: application/json' --data @- "$SLACK_WEBHOOK_URL" >/dev/null 2>&1; then
+      sent=1
+    else echo "[notify] Slack webhook post failed"; fi
+  fi
+  if [[ -n "${NTFY_TOPIC:-}" ]]; then
+    if curl -sS --fail -m 20 -H "Title: ${subject}" -d "${text:0:3500}" "${NTFY_SERVER:-https://ntfy.sh}/${NTFY_TOPIC}" >/dev/null 2>&1; then
+      sent=1
+    else echo "[notify] ntfy post failed"; fi
+  fi
+  [[ $sent == 1 || -z "${SLACK_EMAIL:-}" ]] && return 0
+  msg="$(printf 'To: %s\nFrom: %s@%s\nSubject: %s\n\n%s\n' "$SLACK_EMAIL" "${USER:-mop}" "$(hostname)" "$subject" "$text")"
   sm="$(command -v sendmail 2>/dev/null || ls /usr/sbin/sendmail /usr/lib/sendmail 2>/dev/null | head -n1 || true)"
   if [[ -n "$sm" ]] && printf '%s\n' "$msg" | "$sm" -t 2>/dev/null; then return 0; fi
-  if command -v mail >/dev/null 2>&1 && printf '%s\n' "$body" | mail -s "$subject" "$SLACK_EMAIL" 2>/dev/null; then return 0; fi
+  if command -v mail >/dev/null 2>&1 && printf '%s\n' "$text" | mail -s "$subject" "$SLACK_EMAIL" 2>/dev/null; then return 0; fi
   if printf '%s\n' "$msg" | python3 -c 'import smtplib,sys
 from email import message_from_string
 m = message_from_string(sys.stdin.read())
 with smtplib.SMTP("localhost", 25, timeout=20) as s:
     s.send_message(m)' 2>/dev/null; then return 0; fi
-  echo "[notify] could not send e-mail from $(hostname) (no sendmail/mail/local SMTP); message is only in this log"
+  echo "[notify] could not deliver the message anywhere; it is only in this log"
   return 0
 }
 
diff --git a/cluster/run.sbatch b/cluster/run.sbatch
index e0444ab..ec8e48e 100644
--- a/cluster/run.sbatch
+++ b/cluster/run.sbatch
@@ -21,7 +21,7 @@ cd "$SLURM_SUBMIT_DIR"
 mkdir -p "$RUN_DIR"
 LAYER_SWEEP="${LAYER_SWEEP:-1}"
 T0=$SECONDS
-trap 'notify "FAILED: stage=${STAGE} ${SEED:+seed=$SEED }(line $LINENO)" "$(tail -n 25 "${SLURM_SUBMIT_DIR}/mop-${SLURM_JOB_ID}.out" 2>/dev/null)"' ERR
+trap 'notify "FAILED: stage=${STAGE} ${SEED:+seed=$SEED }(line $LINENO)" "$(tail -n 25 "${SLURM_SUBMIT_DIR}/${SLURM_JOB_NAME}-${SLURM_JOB_ID}.out" 2>/dev/null)"' ERR
 elapsed() { printf '%dh%02dm' $(((SECONDS - T0) / 3600)) $((((SECONDS - T0) % 3600) / 60)); }
 
 train_probes() {  # train_probes <run_name_suffix> <extra hydra args...>   (uses $SEED)
diff --git a/cluster/submit.sh b/cluster/submit.sh
index 3453fa7..9b77ae7 100755
--- a/cluster/submit.sh
+++ b/cluster/submit.sh
@@ -15,13 +15,13 @@ COMMON=(--parsable --account="$SBATCH_ACCOUNT" --export=ALL)
 if [[ "$SMOKE" == "1" ]]; then T_EXTRACT=00:40:00 T_SEED=01:30:00 T_FINAL=00:30:00
 else T_EXTRACT=04:00:00 T_SEED=12:00:00 T_FINAL=02:00:00; fi
 
-prev=$(STAGE=extract sbatch "${COMMON[@]}" --time="$T_EXTRACT" cluster/run.sbatch)
+prev=$(STAGE=extract sbatch "${COMMON[@]}" --job-name=mop-extract --time="$T_EXTRACT" cluster/run.sbatch)
 msg="extract=$prev"
 for seed in $SEEDS; do
-  prev=$(STAGE=seed SEED="$seed" sbatch "${COMMON[@]}" --time="$T_SEED" --dependency=afterok:"$prev" cluster/run.sbatch)
+  prev=$(STAGE=seed SEED="$seed" sbatch "${COMMON[@]}" --job-name="mop-seed$seed" --time="$T_SEED" --dependency=afterok:"$prev" cluster/run.sbatch)
   msg="$msg seed$seed=$prev"
 done
-final=$(STAGE=final sbatch "${COMMON[@]}" --time="$T_FINAL" --dependency=afterok:"$prev" --gpus-per-node=1 --cpus-per-task=8 cluster/run.sbatch)
+final=$(STAGE=final sbatch "${COMMON[@]}" --job-name=mop-final --time="$T_FINAL" --dependency=afterok:"$prev" --gpus-per-node=1 --cpus-per-task=8 cluster/run.sbatch)
 msg="$msg final=$final"
 echo "submitted: $msg   (watch: squeue -u \$USER)"
 notify "pipeline SUBMITTED" "$msg"
