From 07995d2e7f35e32503eb0de427b973be902cf873 Mon Sep 17 00:00:00 2001
From: Sarath <skchingapurathu@gmail.com>
Date: Wed, 21 Oct 2026 20:09:22 -0400
Subject: [PATCH] Load Alliance arrow module for pyarrow; make notify() work
 without mail

pip install of datasets fails on Alliance clusters (pyarrow-noinstall stub)
unless the arrow module is loaded, and pyarrow needs it at runtime too.
notify() now tries sendmail, mail, then smtplib to the local MTA.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01SCnQCibGig91YPGUqFczDv
---
 cluster/config.sh  | 21 +++++++++++++++------
 cluster/run.sbatch |  2 +-
 cluster/setup.sh   |  3 ++-
 3 files changed, 18 insertions(+), 8 deletions(-)

diff --git a/cluster/config.sh b/cluster/config.sh
index 75f9582..410cb96 100755
--- a/cluster/config.sh
+++ b/cluster/config.sh
@@ -44,16 +44,25 @@ export RUN_DIR="$ROOT/outputs/$RUN_NAME"
 export HF_HUB_OFFLINE="${HF_HUB_OFFLINE:-1}" HF_DATASETS_OFFLINE="${HF_DATASETS_OFFLINE:-1}" TRANSFORMERS_OFFLINE="${TRANSFORMERS_OFFLINE:-1}"
 export WANDB_MODE="${WANDB_MODE:-offline}" TOKENIZERS_PARALLELISM=false PYTHONUNBUFFERED=1
 
-# Slack message by e-mail. Never fails the job; prints to the log if mail is unavailable.
+# Slack message by e-mail. Never fails the job; always prints the subject to the log.
+# Tries, in order: sendmail, mail, then Python smtplib to the node's local mail server (port 25).
 # usage: notify "subject" ["body"]
 notify() {
-  local subject="[mop ${RUN_NAME}] $1" body="${2:-}"
+  local subject="[mop ${RUN_NAME}] $1" body="${2:-}" sm msg
   echo "[notify] $subject"
   [[ -z "$SLACK_EMAIL" ]] && return 0
-  { printf '%s\n\nhost=%s job=%s\n' "$body" "$(hostname)" "${SLURM_JOB_ID:-login}"; } \
-    | { mail -s "$subject" "$SLACK_EMAIL" 2>/dev/null \
-        || mailx -s "$subject" "$SLACK_EMAIL" 2>/dev/null \
-        || echo "[notify] no working 'mail' command; message only in log"; } || true
+  msg="$(printf 'To: %s\nFrom: %s@%s\nSubject: %s\n\n%s\n\nhost=%s job=%s\n' \
+         "$SLACK_EMAIL" "${USER:-mop}" "$(hostname -f 2>/dev/null || hostname)" "$subject" "$body" "$(hostname)" "${SLURM_JOB_ID:-login}")"
+  sm="$(command -v sendmail 2>/dev/null || ls /usr/sbin/sendmail /usr/lib/sendmail 2>/dev/null | head -n1 || true)"
+  if [[ -n "$sm" ]] && printf '%s\n' "$msg" | "$sm" -t 2>/dev/null; then return 0; fi
+  if command -v mail >/dev/null 2>&1 && printf '%s\n' "$body" | mail -s "$subject" "$SLACK_EMAIL" 2>/dev/null; then return 0; fi
+  if printf '%s\n' "$msg" | python3 -c 'import smtplib,sys
+from email import message_from_string
+m = message_from_string(sys.stdin.read())
+with smtplib.SMTP("localhost", 25, timeout=20) as s:
+    s.send_message(m)' 2>/dev/null; then return 0; fi
+  echo "[notify] could not send e-mail from $(hostname) (no sendmail/mail/local SMTP); message is only in this log"
+  return 0
 }
 
 # torchrun on every GPU of every allocated node (1 srun task per node)
diff --git a/cluster/run.sbatch b/cluster/run.sbatch
index f0c02ac..e0444ab 100644
--- a/cluster/run.sbatch
+++ b/cluster/run.sbatch
@@ -15,7 +15,7 @@
 set -euo pipefail
 source "${SLURM_SUBMIT_DIR}/cluster/config.sh"
 module purge 2>/dev/null || true
-module load StdEnv/2023 python/3.12 2>/dev/null || true
+module load StdEnv/2023 gcc arrow python/3.12 2>/dev/null || true
 source "$VENV/bin/activate"
 cd "$SLURM_SUBMIT_DIR"
 mkdir -p "$RUN_DIR"
diff --git a/cluster/setup.sh b/cluster/setup.sh
index 88bfa7c..55c4f5f 100755
--- a/cluster/setup.sh
+++ b/cluster/setup.sh
@@ -7,12 +7,13 @@ source cluster/config.sh
 export HF_HUB_OFFLINE=0 HF_DATASETS_OFFLINE=0 TRANSFORMERS_OFFLINE=0   # download needs the network
 
 module purge 2>/dev/null || true
-module load StdEnv/2023 python/3.12 2>/dev/null || echo "[warn] no python/3.12 module, using $(python3 --version)"
+module load StdEnv/2023 gcc arrow python/3.12 2>/dev/null || echo "[warn] module load failed (StdEnv/2023 gcc arrow python/3.12) - run: module spider arrow python"
 mkdir -p "$ROOT/outputs" "$HF_HOME" "$WANDB_DIR" "$(dirname "$VENV")"
 [[ -d "$VENV" ]] || python3 -m venv "$VENV"
 source "$VENV/bin/activate"
 pip install --upgrade pip
 pip install --no-index "torch>=2.9.0" 2>/dev/null || pip install "torch>=2.9.0"   # cluster wheel first
+# pyarrow comes from the cluster's "arrow" module (loaded above); the plain wheel is a stub that fails to build
 pip install -e .
 ln -sfn "$ROOT/outputs" outputs
 
